        function generateNextAvailableDays() {
            const days = [];
            const weekdayNames = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
            const monthNames = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
            let cursor = new Date();

            while (days.length < 5) {
                cursor.setDate(cursor.getDate() + 1);
                const wDay = cursor.getDay();
                if (wDay >= 1 && wDay <= 5) {
                    const iso = cursor.toISOString().split('T')[0];
                    const label = `${weekdayNames[wDay]}, ${cursor.getDate()}. ${monthNames[cursor.getMonth()]}`;
                    days.push({ iso, label, wDay });
                }
            }

            bookingState.availableDays = days;
            bookingState.selectedDateISO = days[0].iso;
            bookingState.selectedDateStr = days[0].label;

            renderDaySelector();
            renderTimeSlotsForDay(days[0].wDay);
        }

        function renderDaySelector() {
            const container = document.getElementById('daySelectorGrid');
            container.innerHTML = bookingState.availableDays.map(d => {
                const active = d.iso === bookingState.selectedDateISO;
                return `
                    <button type="button" onclick="selectBookingDay('${d.iso}', '${d.label}', ${d.wDay})"
                        class="p-3 rounded-xl border-2 text-center transition ${active ? 'border-med-600 bg-med-600 text-white font-bold shadow-sm' : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-med-400 text-slate-700 dark:text-slate-200'}">
                        <span class="block text-xs opacity-80">${d.label.split(',')[0]}</span>
                        <span class="block text-sm font-bold mt-0.5">${d.label.split(',')[1]}</span>
                    </button>
                `;
            }).join('');
        }

        function selectBookingDay(iso, label, wDay) {
            bookingState.selectedDateISO = iso;
            bookingState.selectedDateStr = label;
            renderDaySelector();
            renderTimeSlotsForDay(wDay);
        }

        function renderTimeSlotsForDay(wDay) {
            let slots = ['08:15', '08:45', '09:15', '10:00', '10:45', '11:30'];
            if (wDay === 1 || wDay === 2) {
                slots = slots.concat(['15:15', '16:00', '16:45', '17:15']);
            } else if (wDay === 4) {
                slots = ['08:15', '08:45', '09:15', '15:15', '15:45', '16:30', '17:15'];
            }

            if (!slots.includes(bookingState.selectedTime)) {
                bookingState.selectedTime = slots[0];
            }

            const grid = document.getElementById('timeSlotGrid');
            grid.innerHTML = slots.map(time => {
                const active = time === bookingState.selectedTime;
                return `
                    <button type="button" onclick="selectBookingTime('${time}')"
                        class="py-2.5 px-3 rounded-xl border text-sm font-bold transition ${active ? 'bg-med-600 text-white border-med-600 shadow-sm' : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 hover:border-med-500 text-slate-700 dark:text-slate-200'}">
                        ${time} Uhr
                    </button>
                `;
            }).join('');
        }

        function selectBookingTime(time) {
            bookingState.selectedTime = time;
            const currentDayObj = bookingState.availableDays.find(d => d.iso === bookingState.selectedDateISO);
            renderTimeSlotsForDay(currentDayObj ? currentDayObj.wDay : 1);
        }

