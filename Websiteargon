        // =========================================================================
        function initMap() {
            const coords = [51.0442, 13.7024]; // Kesselsdorfer Str. 2 / Tharandter Str., 01159 Dresden
            const map = L.map('praxisMap', { scrollWheelZoom: false }).setView(coords, 16);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            const marker = L.marker(coords).addTo(map);
            marker.bindPopup(`
                <div style="font-family: sans-serif; padding: 2px;">
                    <strong style="color: #0f766e; font-size: 14px;">Praxis Dr. med. Carola Maiwald</strong><br>
                    <span style="font-size: 12px;">Fachärztin für Allgemeinmedizin<br>Kesselsdorfer Str. 2, 01159 Dresden<br>Tel.: 0351 / 4214295</span>
                </div>
            `).openPopup();
        }

