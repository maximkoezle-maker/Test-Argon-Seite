        function downloadICS() {
            const dateParts = bookingState.selectedDateISO.split('-');
            const timeParts = bookingState.selectedTime.split(':');
            const startDate = new Date(dateParts[0], dateParts[1] - 1, dateParts[2], timeParts[0], timeParts[1]);
            const endDate = new Date(startDate.getTime() + 20 * 60000);

            const formatICSDate = (d) => d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';

            const icsContent = [
                'BEGIN:VCALENDAR',
                'VERSION:2.0',
                'PRODID:-//Praxis Dr. med. Carola Maiwald//DE',
                'BEGIN:VEVENT',
                `DTSTART:${formatICSDate(startDate)}`,
                `DTEND:${formatICSDate(endDate)}`,
                `SUMMARY:Arzttermin Dr. med. Carola Maiwald (${bookingState.reason.title})`,
                'LOCATION:Kesselsdorfer Str. 2\\, 01159 Dresden',
                'DESCRIPTION:Bitte elektronische Gesundheitskarte (eGK) und ggf. Impfpass/Medikamentenplan mitbringen. Tel: 0351 4214295',
                'END:VEVENT',
                'END:VCALENDAR'
            ].join('\r\n');

            const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Termin-Dr-Maiwald-${bookingState.selectedDateISO}.ics`;
            a.click();
            URL.revokeObjectURL(url);
        }

