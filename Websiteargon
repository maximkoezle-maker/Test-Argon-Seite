                banner.className = "p-4 rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 text-rose-700 dark:text-rose-200 text-xs font-semibold";
                banner.textContent = "Bitte füllen Sie Ihren Namen und den Überweisungsgrund aus.";
                banner.classList.remove('hidden');
