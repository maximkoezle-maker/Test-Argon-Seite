        function addMedicationToList() {
            const nameInput = document.getElementById('medNameInput');
            const dosageInput = document.getElementById('medDosageInput');
            const name = nameInput.value.trim();
            const dosage = dosageInput.value.trim() || 'Standardpackung (N2/N3)';

            if (!name) return;
            rxList.push({ name, dosage });
            nameInput.value = '';
            dosageInput.value = '';
            renderRxList();
        }

        function quickAddMed(name, dosage) {
            rxList.push({ name, dosage });
            renderRxList();
        }

        function removeMedication(index) {
            rxList.splice(index, 1);
            renderRxList();
        }

