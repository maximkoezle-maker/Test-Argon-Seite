            const name = document.getElementById('rxPatientName').value.trim();
            const dob = document.getElementById('rxPatientDob').value;
            const delivery = document.getElementById('rxDeliveryMethod').value;
            const banner = document.getElementById('rxSuccessBanner');

            if (!name || !dob || rxList.length === 0) {
                banner.className = "p-3 rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 text-rose-700 dark:text-rose-200 text-xs font-semibold";
                banner.textContent = "Bitte geben Sie Ihren Namen, Ihr Geburtsdatum und mindestens ein Medikament an.";
                banner.classList.remove('hidden');
                return;
            }

            banner.className = "p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 text-emerald-800 dark:text-emerald-200 text-xs font-semibold";
            banner.innerHTML = `✓ E-Rezept-Anforderung für <strong>${name}</strong> (${rxList.length} Präparat/e per ${delivery}) wurde erfolgreich an das Praxisteam Dr. Maiwald übermittelt.`;
